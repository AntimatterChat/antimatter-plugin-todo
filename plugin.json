{
    "id": "com.mattermost.plugin-todo",
    "name": "Todo",
    "description": "Todo lists: your own, the ones you send and receive, and a shared list for every channel.",
    "homepage_url": "https://github.com/antimatterchat/antimatter-plugin-todo",
    "support_url": "https://github.com/antimatterchat/antimatter-plugin-todo/issues",
    "icon_path": "assets/icon.svg",
    "min_server_version": "12.0.0",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    }
